@model GCC_Canteen.ViewModel.UserListModel
@{
    ViewBag.Title = "User-List";
    Layout = "~/Views/Shared/_GCC_CanteenMaster.cshtml";
    ViewBag.PageName = "User";
}
<script type="text/javascript">
    $(document).on('click', '#btnAddNew', function () {
        document.location = '@Url.Action("New", "User")';
    });
</script>
<style>
    input[type="checkbox"][readonly] {
        pointer-events: none;
    }
</style>
<div class="panel panel-white">
    @Html.Partial("_SearchPanel", Model.gridSettingData.WebGridColumnSetting)
    <div style="margin-left: 15px;margin-right: 15px;">
        <div class="table-responsive">
            @if (ViewBag.SearchCriteria != null)
            {
                <div style="margin-left:15px;">
                    @*<h4 style="font-size:14px;margin-bottom:5px;">Result Criteria</h4>*@
                    <label id="lblSearchCriteria"><b>@ViewBag.SearchCriteria.ToString()</b></label>
                </div>
            }
            <div id="ctrlGrid1Panel">
                @Html.Partial("_GridView", Model.UserList, new ViewDataDictionary { { "ColumnsSetting", Model.gridSettingData.WebGridColumns }, { "WebGridSettings", Model.gridSettingData.WebGridSetting }, { "WriteAccess", ViewBag.WriteAccess }, { "FilterSession", ViewBag.FilterSession }, { "SearchCriteria", ViewBag.SearchCriteria } })
            </div>
        </div>
    </div>
</div>

