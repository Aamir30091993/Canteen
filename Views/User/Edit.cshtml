            window.location.href = 'List?FilterSession=' + $('#FilterSession').val();
        }
        else {
            window.location.href = 'List';
        }
    })

    $('#btnDelete').click(function (e) {
        debugger;
        e.preventDefault();
        $('#myModal80').modal({ backdrop: 'static', keyboard: false });
    })
</script>

