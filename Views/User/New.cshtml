@*Access Part*@
<script>
    $(document).ready(function () {
        debugger;
        var couter = 0;
        $('#tblPageAccessView').find('.chbAccess').each(function () {
            if ($(this)[0].checked == true) {
                couter++;
            }
        });
        if ($('#tblPageAccessView').find('.chbAccess').length == couter) {
            $('#HeaderPageAccessAccess')[0].checked = true;
        }
        else {
            $('#HeaderPageAccessAccess')[0].checked = false;
        }

    });
</script>

@*Save class Location*@

<script>
    $('.btnSaveClick').click(function (e) {
        debugger;
        var $form = $('#form0');
        if ($form.valid()) {
            $('#spinner').show();
            var Errormsg = "";
            var valid = true;
            var listSpecific = $('input[type="radio"][value="Specific"]:checked').toArray();
            if (valid) {
                var strLocationAccess = "";
                $("#tblPageAccessView > tbody > tr").each(function () {
                    debugger;
                    var LocationID = $(this).find('#hdfLocationID')[0].value;
                    var Access = $(this).find('#chbAccess')[0].checked == true ? 1 : 0;

                    strLocationAccess = strLocationAccess == "" ? LocationID + ',' + Access : strLocationAccess + '|' + LocationID + ',' + Access;
                })

                debugger;
                $.ajax({
                    url: '/User/UpdateLocationAccess/',
                    dataType: 'html',
                    data: JSON.stringify({ UserID: 0, strLocationAccess: strLocationAccess }),
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    success: function (data) {
                        $('#spinner').hide();
                    }
                });
            }
            else {
                $('#spinner').hide();
                alert(Errormsg);
                return false;
            }
        }
    });
</script>




