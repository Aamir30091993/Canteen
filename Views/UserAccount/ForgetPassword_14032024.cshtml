<body class="page-login">

    <div id="modalUpdatePassword" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-body">
                    <span id="forgetpassword-popup">New Password created successfully</span>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" id="btnOk">Ok</button>
                    <input type="hidden" value="" id="hdfOkID" />
                </div>
            </div>

        </div>
    </div>
    <div id="divAlertMessage" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-body">
                    <p class="AlertMessage"></p>
                </div>
                <div class="modal-footer">
                    <button id="CloseAlert" type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <main class="page-content">
        <div class="page-inner">
            <div id="main-wrapper" style="margin:0">
                <div class="row">
                    <div class="col-md-9 " style="-webkit-box-shadow: inset -15px 0 16px -24px rgba(0,0,0,0.75);
-moz-box-shadow: inset -15px 0 16px -24px rgba(0,0,0,0.75);
box-shadow: inset -15px 0 16px -24px rgba(0,0,0,0.75);padding-right:0px">
                        <div style="margin-right: 12px;">
                            <div id="myCarousel" class="carousel slide" data-ride="carousel">

                                <div class="carousel-inner" role="listbox">
                                    <div class="item active">
                                        <img src="~/assets/Images/img1.jpg" width="100%" height="100%">
                                    </div>
                                    <div class="item">
                                        <img src="~/assets/Images/img2.jpg" width="100%" height="100%">
                                    </div>
                                    <div class="item">
                                        <img src="~/assets/Images/img3.jpg" width="100%" height="100%">
                                    </div>
                                    <div class="item">
                                        <img src="~/assets/Images/img4.jpg" width="100%" height="100%">
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div style="margin: 30% 7% 0 2%;">
                            <div class="login-box">
                                <a href="#" class="logo-name text-lg text-center"><img src="~/assets/Images/logo_big.png" style="width:230px;"></a>
                                @using (Ajax.BeginForm("ForgotPassword", new AjaxOptions { HttpMethod = "POST", OnBegin = "OnBeginForgetPass", OnSuccess = "ConfirmModalPopup", OnFailure = "" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <div id="section2">
                                        <p class="text-center m-t-md">Reset Password</p>
                                        <div class="form-group">
                                            @Html.TextBoxFor(m => m.LoginID, new { @class = "form-control", placeholder = "Login Name", autocomplete = "off" })
                                            <p id="MsgLogin" style="text-align: center;color:red"></p>
                                            @*@Html.ValidationMessageFor(m => m.LoginID, "", new { @class = "text-danger" })*@
                                        </div>
                                        <div class="form-group">
                                            @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "New Password", @type = "Password", autocomplete = "off" })
                                            <p id="MsgPass1" style="text-align: center;color:red"></p>
                                            @*@Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })*@
                                        </div>
                                        <div class="form-group">
                                            @Html.PasswordFor(m => m.ConfirmNewPassword, new { @class = "form-control", placeholder = "Confirm Password", @type = "Password", autocomplete = "off" })
                                            <p id="MsgPass2" style="text-align: center;color:red"></p>
                                            @*@Html.ValidationMessageFor(m => m.ConfirmNewPassword, "", new { @class = "text-danger" })*@
                                        </div>
                                        <button type="submit" class="btn btn-success btn-block">Submit</button>
                                        <a style="cursor:pointer" class="display-block text-center m-t-md text-sm" href="~/UserAccount/Login" id="show-login-screen">
                                            <i class="fa fa-long-arrow-left"></i>
                                            Back to Login
                                        </a>
                                    </div>

                                }
                                <hr>
                                <p class="text-center m-t-xs text-sm">&copy; Hapag-Lloyd AG</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="~/assets/plugins/jquery-ui/jquery-ui.min.js"></script>
