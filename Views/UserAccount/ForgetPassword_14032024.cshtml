    <script src="~/scripts/jquery.validate.min.js" type="text/javascript"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
    <script type="text/javascript">

        function OnBeginForgetPass() {
            debugger;
            var flag = true;
            if ($('#LoginID').val() == '') {
                $('#MsgLogin').html('Login Name is required');
                flag = false;
            }
            if ($('#NewPassword').val() == '') {
                $('#MsgPass1').html('Password is required');
                flag = false;
            }
            if ($('#ConfirmNewPassword').val() == '') {
                $('#MsgPass2').html('Confirm Password is required');
                flag = false;
            }
            if ($('#NewPassword').val() != $('#ConfirmNewPassword').val()) {
                $('#divAlertMessage').modal('show');
                $('.AlertMessage').html('New Password and Confirm New Password is not matching');
                //alert('New Password and Confirm New Password is not matching')
                flag = false;
            }
            return flag;
        }

        function ConfirmModalPopup(result) {
            debugger;
            ////var ErrorMsg = result.ErrorMsg;
            ////alert($('#myModal85 #forgetpassword-popup').text(ErrorMsg))
            ////$('#myModal85 div span').html(result.ErrorMsg) ;
            //$('#modalUpdatePassword #forgetpassword-popup').text(result.ErrorMsg);
            //$('#modalUpdatePassword').modal('show');

            //$('#hdfOkID').val(result.Url);
            if (result == '') {
                $('#modalUpdatePassword').modal('show');
                $('#hdfOkID').val('Login');
            }
            else {
                $('#divAlertMessage').modal('show');
                $('.AlertMessage').html('Login Name is Invalid');
            }
        }
    </script>
    <script type="text/javascript">
        $('#btnOk').click(function (e) {
            debugger;
            window.location.href = $('#hdfOkID').val();
        });
    </script>
    <script>
        setTimeout(function () {
            debugger;
            $('#LoginID').val('');
            $('#NewPassword').val('');
        }, 1000);
    </script>
</body>
