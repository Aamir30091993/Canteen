@model GCC_Canteen.ViewModel.UpdatePassword

@{
    ViewBag.Title = "Change Password";
    ViewBag.PageName = "Change Password";
    Layout = "~/Views/Shared/_GCC_CanteenMaster.cshtml";
}
@*<script src="~/Scripts/bootstrap.min.js"></script>*@ 
<script src="~/Scripts/jquery.validate.min.js"></script>

@using (Ajax.BeginForm("ChangePassword", new AjaxOptions { HttpMethod = "POST", OnSuccess = "OnSuccess1", OnFailure = "OnFailure1" }))
{    
    @*<div id="main-wrapper">
        <div class="row">
            <div class="col-md-12">*@

                <div class="panel panel-white">
                    <div class="panel-heading clearfix" id="search-title">
                    </div>
                    <div class="panel-body" id="divChangePassword" style="margin-left:10px">
                        <div class="row">

                            <div style="height: auto;" id="collapseOne" class="accordion-body collapse in">
                                <div class="row">
                                    @Html.AntiForgeryToken()
                                    <div class="col-md-6 col-md-offset-0">
                                        <div class="form-group">
                                            <label for="username">Welcome : @Model.UserName </label>
                                            @Html.HiddenFor(m => m.UserID)
                                            @*@Html.HiddenFor(m => m.ClientID)*@
                                            @Html.HiddenFor(m => m.LoginName)
                                        </div>
                                        <div class="form-group">
                                            <label for="loginName">Your Login Name is : @Model.LoginName </label>
                                        </div>
                                        <div class="form-group">
                                            @Html.Label("Current Password")
                                            @Html.PasswordFor(m => m.Password, new { @class = "form-control text-mandatory", placeholder = "" })
                                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="form-group">
                                            @Html.Label("New Password")
                                            @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control text-mandatory", placeholder = "" })
                                            @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="form-group">
                                            @Html.Label("Confirm New Password")
                                            @Html.PasswordFor(m => m.ConfirmNewPassword, new { @class = "form-control text-mandatory", placeholder = "" })
                                            @Html.ValidationMessageFor(m => m.ConfirmNewPassword, "", new { @class = "text-danger" })
                                        </div>

                                    </div>
                                </div>
                                <br>
                            </div>


                        </div>
                    </div>

                    <div class="row" id="divButtons">
                        <div style="padding:15px 0 0 30px" id="action-button">
                            <button class="btn btn-primary" type="submit">Change Password</button>
                            @*<button class="btn btn-primary" type="button" style="margin-left:15px;width:80px" id="btnCancel">Back</button>*@
                        </div>
                    </div>


                    <br><br>
                </div>
            
    @*</div>
        </div>
    </div>*@
}


<div id="modalChangePasswordSuccess" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-body">
                <p>Password Updated Successfully.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" id="btnOk">Ok</button>
                <input type="hidden" value="" id="hdfOkID" />
            </div>
        </div>

    </div>
</div>

<div id="modalChangePasswordFailure" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-body">
                <p>Password Not Updated Successfully Please try again.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" id="btnNotOk">Ok</button>
                <input type="hidden" value="" id="hdfNotOkID" />
            </div>
        </div>

    </div>
</div>

<script type="text/javascript">
    $('#btnOk').click(function (e) {
        window.location.href = $('#hdfOkID').val();
    });

    $('#btnNotOk').click(function (e) {
        window.location.href = $('#hdfNotOkID').val();
    });
</script>

<script type="text/javascript">
    function OnSuccess1() {
        debugger;
        $('#modalChangePasswordSuccess').modal('show');
        $('#hdfOkID').val('/UserAccount/Login');

    }

   
    function OnFailure1() {
        debugger;
        $('#modalChangePasswordFailure').modal('show');
        $('#hdfNotOkID').val('');

    }

    $('#btnCancel').click(function (e) {
        e.preventDefault();
        window.location.href = '/Dashboard/Show';
    })
</script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>