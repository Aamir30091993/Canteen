@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <!-- Title -->
    <title>Intranet Portal Logout</title>

    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta charset="UTF-8" />
    <meta name="description" content="Admin Dashboard Template" />
    <meta name="keywords" content="admin,dashboard" />
    <meta name="author" content="Steelcoders" />

    <!-- Styles -->
    <!-- Styles -->
    <link href='https://fonts.googleapis.com/css?family=Roboto:400,300,500,700' rel='stylesheet' type='text/css' />
    <link href="~/assets/plugins/pace-master/themes/blue/pace-theme-flash.css" rel="stylesheet" />
    <link href="~/assets/plugins/uniform/css/uniform.default.min.css" rel="stylesheet" />
    <link href="~/assets/plugins/bootstrap/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/plugins/fontawesome/css/font-awesome.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/plugins/line-icons/simple-line-icons.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/plugins/offcanvasmenueffects/css/menu_cornerbox.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/plugins/waves/waves.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/plugins/switchery/switchery.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/plugins/3d-bold-navigation/css/style.css" rel="stylesheet" type="text/css" />
    <script src="~/assets/plugins/jquery/jquery-2.1.3.min.js"></script>
    <!-- Theme Styles -->
    <link href="~/assets/css/modern.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/themes/white.css" class="theme-color" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/custom.css" rel="stylesheet" type="text/css" />

    <script src="~/assets/plugins/3d-bold-navigation/js/modernizr.js"></script>
    <script src="~/assets/plugins/offcanvasmenueffects/js/snap.svg-min.js"></script>

    <script src="@Url.Content("~/assets/plugins/3d-bold-navigation/js/modernizr.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/assets/plugins/offcanvasmenueffects/js/snap.svg-min.js")" type="text/javascript"></script>

    <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/html5shiv/3.7.2/html5shiv.min.js"></script>
    <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
    <![endif]-->

    <script>
    $(document).on('mouseenter', '#link-foot', function () {
        $('#link').hide();
        $('#link1').show();
    })
    $(document).on('mouseleave', '#link-foot', function () {
        $('#link').show();
        $('#link1').hide();
    })


    $(document).on('mouseleave', '#twt-foot', function () {
        $('#twt').show();
        $('#twt1').hide();
    })
    $(document).on('mouseenter', '#twt-foot', function () {
        $('#twt').hide();
        $('#twt1').show();
    })

    $(document).on('mouseenter', '#Facebook-foot', function () {
        $('#fcbk').hide();
        $('#fcbk1').show();
    })
    $(document).on('mouseleave', '#Facebook-foot', function () {
        $('#fcbk').show();
        $('#fcbk1').hide();
    })

    $(document).on('mouseenter', '#Youtube-foot', function () {
        $('#ytbe').hide();
        $('#ytbe1').show();
    })
    $(document).on('mouseleave', '#Youtube-foot', function () {
        $('#ytbe').show();
        $('#ytbe1').hide();
    })

    $(document).on('mouseenter', '#Instagram-foot', function () {
        $('#inst').hide();
        $('#inst1').show();
    })
    $(document).on('mouseleave', '#Instagram-foot', function () {
        $('#inst').show();
        $('#inst1').hide();
    })
    </script>
</head>
<body>
    <main class="page-content">
        <div class="page-inner">
            <div id="main-wrapper" style="margin:0">
                <div class="row" style="height:0px;">
                    <div class="panel panel-white">
                        <div class="navbar" style="background-color:#012056;background-repeat: no-repeat;background-size: cover;">
                            <div class="logo-box">
                                <a href="/UserAccount/Login">
                                    <img src="~/assets/Images/logo-new.png" style="margin-left:15px;padding-top:3px;" />
                                </a>
                            </div>
                        </div>
                        <div class="panel-body">
                            <div class="col-md-12">
                                <div style="text-align:center">
                                    <p style="font-weight:bold;font-size:30px;height:50px;"></p>
                                    <p style="font-weight:bold;font-size:30px">Intranet Portal Logout</p>
                                    <p style="font-weight:bold;font-size:30px;height:50px;"></p>
                                    <p style="font-weight:normal;font-size:22px">You have been successfully logout of the Intranet Portal.</p>
                                    <p>For security reasons, please <b>exit/quit</b> your web browser.</p>
                                    <p style="font-weight:bold;font-size:30px;height:100px;"></p>
                                    <p><a href="~/UserAccount/Login">Click here to Login.</a></p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div><!-- Row -->
                <div class="page-footer" style="width:100%;">
                    <div class="col-md-6" style="margin-top:12px">
                        <p>© GCC CANTEEN</p>
                    </div>
                    <div class="col-md-6" style="padding-right:4%;">
                        <a id="Instagram-foot" href="https://instagram.com" target="_blank">
                            <img src="~/assets/Images/ico_instagram_n.png" id="inst" style="float:right;padding-left:5px;">
                            <img src="~/assets/Images/ico_instagram_h.png" id="inst1" style="display:none;float:right;padding-left:5px;">
                        </a>
                        <a id="Youtube-foot" href="https://www.youtube.com/channel/UCh_mQliBh07CaPbc3-0ETNQ" target="_blank">
                            <img src="~/assets/Images/ico_youtube_n.png" id="ytbe" style="float:right;padding-left:5px;">
                            <img src="~/assets/Images/ico_youtube_h.png" id="ytbe1" style="display:none;float:right;padding-left:5px;">
                        </a>
                        <a id="Facebook-foot" href="https://www.facebook.com/Colliers.OutForGood" target="_blank">
                            <img src="~/assets/Images/ico_facebook_n.png" id="fcbk" style="float:right;padding-left:5px;">
                            <img src="~/assets/Images/ico_facebook_h.png" id="fcbk1" style="display:none;float:right;padding-left:5px;">
                        </a>
                        <a id="twt-foot" href="https://twitter.com/Colliersintlind" target="_blank">
                            <img src="~/assets/Images/ico_twitter_n.png" id="twt" style="float:right;padding-left:5px;">
                            <img src="~/assets/Images/ico_twitter_h.png" id="twt1" style="display:none;float:right;padding-left:5px;">
                        </a>
                        <a id="link-foot" href="https://www.linkedin.com/company/3828074?trk=tyah&amp;trkInfo=clickedVertical%3Acompany,clickedEntityId%3A3828074,idx%3A1-1-1,tarId%3A1438754337911,tas%3Acolliers international india" target="_blank">
                            <img src="~/assets/Images/ico_linkedin_n.png" id="link" style="float:right;padding-left:5px;">
                            <img src="~/assets/Images/ico_linkedin_h.png" id="link1" style="display:none;float:right;padding-left:5px;">
                        </a>
                        @Html.Hidden("hdfSearchURL")
                    </div>
                </div>
            </div><!-- Main Wrapper -->
        </div><!-- Page Inner -->
    </main><!-- Page Content -->
    <!-- Javascripts -->

    <script src="~/assets/plugins/jquery-ui/jquery-ui.min.js"></script>
    <script src="~/assets/plugins/pace-master/pace.min.js"></script>
    <script src="~/assets/plugins/jquery-blockui/jquery.blockui.js"></script>
    <script src="~/assets/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="~/assets/plugins/jquery-slimscroll/jquery.slimscroll.min.js"></script>
    <script src="~/assets/plugins/uniform/jquery.uniform.min.js"></script>
    <script src="~/assets/plugins/offcanvasmenueffects/js/classie.js"></script>
    <script src="~/assets/plugins/offcanvasmenueffects/js/main.js"></script>
    <script src="~/assets/plugins/waves/waves.min.js"></script>
    <script src="~/assets/plugins/3d-bold-navigation/js/main.js"></script>
    <script src="~/assets/js/modern.min.js"></script>

</body>





</html>
