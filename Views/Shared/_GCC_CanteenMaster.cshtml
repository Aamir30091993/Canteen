    <script>
        $(document).ready(function () {
            debugger;
            $("#hdfSearchURL").val(window.location.href.toString());
        });

        function SetLinkURL(obj, paging) {
            debugger;
            $("#hdfSearchURL").val();
            for (var url = 0; url < $("#" + obj + " thead tr th a").length; url++) {
                $("#" + obj + " thead tr th a")[url].href = $("#hdfSearchURL").val().split('?').length == 2 ? ($("#" + obj + " thead tr th a")[url].href.toString()).replace($("#" + obj + " thead tr th a")[url].href.toString().split('?')[0], $("#hdfSearchURL").val().split('?').length == 2 ? ($("#hdfSearchURL").val().split('?')[0]) : ($("#hdfSearchURL").val())) + '&' + ($("#hdfSearchURL").val().split('?')[1]) : ($("#" + obj + " thead tr th a")[url].href.toString()).replace($("#" + obj + " thead tr th a")[url].href.toString().split('?')[0], ($("#hdfSearchURL").val()));
                //$("#" + obj + " thead tr th a")[url].href = ($("#" + obj + " thead tr th a")[url].href.toString()).replace($("#" + obj + " thead tr th a")[url].href.toString().split('?')[0], $("#hdfSearchURL").val());
            }
            debugger;
            if ($("#" + obj + " tbody tr").length > 1) {
                for (var sepr = 0; sepr < $("#" + paging + " .pagination")[0].childNodes.length; sepr++) {
                    var herf = $("#" + paging + " .pagination")[0].childNodes[sepr].children[0].href.replace($("#" + paging + " .pagination")[0].childNodes[sepr].children[0].href.split('?')[0], $("#hdfSearchURL").val());

                    var indexof = herf.indexOf('?');
                    var length = herf.length;
                    if (indexof > 0) {
                        $("#" + paging + " .pagination")[0].childNodes[sepr].children[0].href = herf.substring(0, indexof + 1) + herf.substring(indexof + 1, length).replace('?', '&');

                    } else {
                        $("#" + paging + " .pagination")[0].childNodes[sepr].children[0].href = $("#" + paging + " .pagination")[0].childNodes[sepr].children[0].href.replace($("#" + paging + " .pagination")[0].childNodes[sepr].children[0].href.split('?')[0], $("#hdfSearchURL").val());
                    }
                }
            }
            removefooter();
        }
    </script>
