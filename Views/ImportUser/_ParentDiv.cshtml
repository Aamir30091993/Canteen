@model GCC_Canteen.ViewModel.ImportUserViewModel
@*@model IEnumerable<ImportUserViewModel>*@

@if (Model._ImportTempViewData != null)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Location</th>
                <th>User Name</th>
                <th>Employee Code</th>
                <th>Card No</th>
                <th>User ID</th>
                <th>Employee Designation</th>
                <th>Team Name</th>
                <th>Reporting To</th>
                <th>Reporting To Employee Code</th>
                <th>Reporting To Designation</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model._ImportTempViewData)
            {
                <tr>
                    <td>@item.Location</td>
                    <td>@item.UserName</td>
                    <td>@item.EmpCode</td>
                    <td>@item.CardNo</td>
                    <td>@item.UserID</td>
                    <td>@item.EmpDesignation</td>
                    <td>@item.TeamName</td>
                    <td>@item.ReportingTo</td>
                    <td>@item.ReportingToEmpCode</td>
                    <td>@item.ReportingToDesignation</td>
                </tr>
            }
        </tbody>
    </table>
}

