@model GCC_Canteen.ViewModel.ImportUserViewModel
@{
    WebGrid webGrid;
    webGrid = new WebGrid(Model._ImportUserStatistics, canPage: false, canSort: false, ajaxUpdateContainerId: "StatisticsGrid");
}
<div id="gridStatistics">
    @if (Model._ImportUserStatistics != null)
    {
        @webGrid.Table(
                 headerStyle: "Header",
                 footerStyle: null,
                 alternatingRowStyle: "even",
                 selectedRowStyle: null,
                 rowStyle: "odd",
                 caption: null,
                 displayHeader: false,
                 fillEmptyRows: false,
                 emptyRowCellValue: null,
                 htmlAttributes: new { @class = "display table dataTable", style = "width: 50%;float:left; cellspacing: 0;margin-top:0px;overflow:auto", id = "statisticsGrid" },

    columns:
    webGrid.Columns(
        webGrid.Column("", format:
            @<text>
                @item.StatisticsDetails
            </text>, canSort: false),

                     webGrid.Column("", format:
                    @<text>
                        @item.StatisticsValue
                    </text>, canSort: false)
                                                       ))
    }
    else
    {
        @*<table id="example2" class="display table dataTable" style="width: 100%; cellspacing: 0;margin-top:0px;overflow:auto">
                <thead>
                    <tr style="background-color:#e2e2e2">
                        <th>Client Name <i style="float:none"></i></th>
                        <th>Address <i style="float:none"></i></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>*@
        <div></div>
    }
</div>
<style>
    .Header {
        background-color: #e2e2e2;
        width: 100%;
    }

        .Header a {
            font-family: 'Roboto', sans-serif !important;
            font-size: 14px;
            color: #4E5E6A;
        }
</style>


