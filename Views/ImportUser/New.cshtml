<!-- Table to display data -->

<div class="panel panel-default" style="overflow: auto; height: calc(100vh - 345px);">
    <div class="panel-heading">
        <h3 class="panel-title">Temp Staff Data</h3>
    </div>
    <div class="panel-body">
        <table class="table table-striped" id="tempStaff">
            <thead>
                <tr>
                    <th>Location</th>
                    <th>User Name</th>
                    <th>Employee Code</th>
                    <th>Card No</th>
                    <th>User ID</th>
                    <th>Employee Designation</th>
                    <th>Team Name</th>
                    <th>Reporting To</th>
                    <th>Reporting To Emp Code</th>
                    <th>Reporting To Designation</th>
                </tr>
            </thead>
            <tbody>
                <!-- Table rows will be dynamically populated via AJAX -->
            </tbody>
        </table>
    </div>
</div>

<script src="~/Scripts/JSScript/ImportUser.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.js"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
<script type="text/javascript">

    $('#btnCancel').click(function (e) {
        e.preventDefault();
        window.location.href = 'List';
    })


    //$('#btnView').click(function (e) {
    //    e.preventDefault();
    //    window.location.href = 'ViewData';
    //})
    $('#btnView').click(function (e) {
        e.preventDefault();
       $.ajax({
    url: '/Canteen/ImportUser/ViewData',  // Replace ControllerName with your actual controller name
    type: 'GET',
    dataType: 'json',
    success: function(response) {
        if (response.success) {
            // Assuming response.data contains your ImportUserViewModel
            var tableData = response.data._ImportTempViewData;

            // Clear existing table rows
            $('#tempStaff tbody').empty();

            // Populate table with updated data
            $.each(tableData, function(index, item) {
                var row = $('<tr>');
                row.append($('<td>').text(item.Location));
                row.append($('<td>').text(item.UserName));
                row.append($('<td>').text(item.EmpCode));
                row.append($('<td>').text(item.CardNo));
                row.append($('<td>').text(item.UserID));
                row.append($('<td>').text(item.EmpDesignation));
                row.append($('<td>').text(item.TeamName));
                row.append($('<td>').text(item.ReportingTo));
                row.append($('<td>').text(item.ReportingToEmpCode));
                row.append($('<td>').text(item.ReportingToDesignation));

                $('#tempStaff tbody').append(row);
            });
        } else {
            console.error('Error: ' + response.message);
        }
    },
    error: function(xhr, status, error) {
        console.error('Error fetching data: ', error);
    }
});
    });

