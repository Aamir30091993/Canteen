@model GCC_Canteen.ViewModel.ImportUserViewModel
@{
    ViewBag.Title = "New";
    Layout = "~/Views/Shared/_GCC_CanteenMaster.cshtml";
    ViewBag.PageName = "Upload Staff (Temp/Visitor)";
}

<link rel="Stylesheet" type="text/css" href="/assets/css/select2.css" />
<link href="/assets/css/modern.css" rel="stylesheet" type="text/css" />
<script src="~/Scripts/jquery.validate.min.js"></script>

<script type="text/javascript">
    $(function () {
        $("#datepicker").datepicker({
            format: "dd/mm/yyyy",
            autoclose: true
        });
    });
</script>

<script type="text/javascript">
    $(document).ready(function (e) {
        $("#divClearAttachment").hide();
    });
</script>

@using (Ajax.BeginForm("Save",
            new AjaxOptions
            {
                OnSuccess = "AddSuccess",
                OnFailure = "AddSuccess",
                HttpMethod = "POST"
            }))
{
    <div id="myModalSave" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-body">
                    Data Imported Successfully!!!
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" id="btnClose">Close</button>
                </div>
            </div>
        </div>
    </div>
}
<style>
    /* CSS for making the table header sticky */
    #tempStaff thead {
        position: sticky;
        top: 0;
        background-color: #f9f9f9;
        z-index: 10;
    }
</style>
