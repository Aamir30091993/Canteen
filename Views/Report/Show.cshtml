<script>
    //Report
    $('#ddlReport').change(function (e) {
        debugger;
        var report = $('#ddlReport').val();
        $('#ReportParameterDetails_ReportID').val(report);
        $('#ReportName').val(e.currentTarget.selectedOptions[0].innerHTML);
        debugger;
    });

    function OnBeginReport() {
        debugger;
        $("#spinner").show();
        $('#paramValMsg').css('display', 'none');
    };

    function Display(data1) {
        debugger;
        data1 = "Export"; //Added by Aamir - 06/03/2024
        $("#spinner").hide();
        $("#section101").show();
        $("#section100").hide();
        $('#ReportParameter').css('display', 'block');
        if (data1 == true) {
            $("#ReportParameter").show();
            $("#GridReport").hide();
            //  $("#CrystalReport").show();
            // $("#iCrystalReport").attr('src', '/WebForm/CrystalReportViewer.aspx');
            window.open('/WebForm/CrystalReportViewer.aspx?SessionIdentifier=' + $("#hdfSessionIdentifier").val(), true);
            // win.focus();
        }
        else {
            if (data1 == "Export") {
                window.location.href = "/Report/Export?ReportName=" + $("#ReportName").val() + "&ReportID=" + $("#ReportParameterDetails_ReportID").val() + "&SessionIdentifier=" + $("#hdfSessionIdentifier").val();
            }
            else {
                //$("#ReportParameter").hide();
                $("#GridReport").show();
                //$("#section101").css("display","block");
                $("#GridReport").html(data1);
                $('.gridresults').dataTable({
                    "sPaginationType": "full_numbers",
                    "bSort": false,
                    "bFilter": false,
                    "bInfo": false,
                    "lengthChange": false
                });
            }
        }
        $('#graph_view').css('display', 'none');
        $('#GridReport').css('display', 'block');
        //else
        //    window.open("../GenericReportViewer/ShowGenericRpt", 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

    // Function to check if EventID is selected, and set its value to null if not selected
    function checkEventID() {
        var eventIDSelected = $('#ddlEventTypeReport').val();
        if (!eventIDSelected) {
            // If EventID is not selected, set its value to null
            $('#ReportParameterDetails_EventID').val(null);
        }
    }


    $(function () {
        debugger;
        //var MinimimDate = new Date();
        //MinimimDate.setDate(MinimimDate.getDate());
        $("#ReportParameterDetails_ReportFromDate").datepicker(
            {
                todayHighlight: 'TRUE',
                format: 'dd/mm/yyyy',
                autoclose: true,
                startDate: '01/01/1900'//MinimimDate//new Date()

            }).on('changeDate', function (ev) {
                debugger;
                ev.date.toDateString()


            });

        // Attach the checkEventID function to the form submission
        $("form").submit(function () {
            checkEventID();
        });
    });

