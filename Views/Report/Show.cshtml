         color: #fff;
         font-weight: bold;
     }*/
</style>


@using (Ajax.BeginForm("Show", "Report", new AjaxOptions { HttpMethod = "POST", OnSuccess = "Display", OnFailure = "SaveFaluire", OnBegin = "OnBeginReport" }))
{
    <div class="panel panel-white">
        <div id="ReportParameter" style="margin-left: 15px;margin-top: 15px;">
            @Html.HiddenFor(m => m.ReportParameterDetails.ReportID)
            @*@Html.HiddenFor(m => m.ReportParameterDetails.ReportTypeID)*@
            <input type="hidden" id="hdfSessionIdentifier" value=@Convert.ToString(TempData["SessionIdentifier"])>
            @Html.Hidden("ReportName")
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        @Html.Label("Report Type")
                        @Html.DropDownListFor(m => m.ReportParameterDetails.ReportID, ViewBag.ReportTypeList == null ? new List<SelectListItem>
                        { new SelectListItem { Value = "", Text = "" } } : (IEnumerable<SelectListItem>)ViewBag.ReportTypeList, "--Select--"
                        , new { id = "ddlReport", @class = "form-control m-b-sm", @style = "width: 100%;color:#999;margin-bottom: 0px;" })
                        @Html.ValidationMessageFor(m => m.ReportParameterDetails.ReportID, "", new { @class = "text-danger" })
                        @Html.HiddenFor(m => m.ReportParameterDetails.ReportID)
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        @Html.Label("From Date")
                        @Html.TextBoxFor(m => m.ReportParameterDetails.ReportFromDate, new { @class = "form-control text-mandatory", @autocomplete = "off" })
                        @Html.ValidationMessageFor(m => m.ReportParameterDetails.ReportFromDate, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        @Html.Label("To Date")
                        @Html.TextBoxFor(m => m.ReportParameterDetails.ReportToDate, new { @class = "form-control text-mandatory", @autocomplete = "off" })
                        @Html.ValidationMessageFor(m => m.ReportParameterDetails.ReportToDate, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        @Html.Label("Event Type")
                        @Html.DropDownListFor(m => m.ReportParameterDetails.EventID, ViewBag.EventTypeList == null ? new List<SelectListItem>
                        { new SelectListItem { Value = "", Text = "" } } : (IEnumerable<SelectListItem>)ViewBag.EventTypeList, "--Select--"
                        , new { id = "ddlEventTypeReport", @class = "form-control m-b-sm", @style = "width: 100%;color:#999;margin-bottom: 0px;" })
                        @Html.HiddenFor(m => m.ReportParameterDetails.EventID)
                    </div>
                </div>

                @*<br />*@
                <div class="row">
                    <div class="col-md-12">
                        <button class="btn btn-primary" type="submit" style="margin-left:15px;width:120px" disabled=@ViewData["WiteAccess"]>Generate Report</button>

                    </div>
                </div>
                @*<br />*@
            </div>

            <div id="GridReport" style="display:none;">
                @Html.Partial("_GridReport")
            </div>
            <br />
        </div>
    </div>
}

<script src="https://cdn.datatables.net/1.10.13/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.10.13/js/dataTables.bootstrap.min.js"></script>
