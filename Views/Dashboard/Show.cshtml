<style>
    body {
        font-family: 'Roboto', sans-serif;
        background-color: #f8f9fa;
        margin: 0;
        padding: 0;
    }

    .container {
        max-width: 800px;
        margin: 25px auto;
        padding: 20px;
        background-color: #fff;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        border-radius: 8px;
    }

    .header {
        text-align: center;
        margin-bottom: 20px;
    }

        .header img {
            width: 100px;
        }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }

        .form-group input,
        .form-group select {
            width: calc(100% - 20px);
            padding: 10px;
            margin: 5px 0;
            border: 1px solid #ced4da;
            border-radius: 4px;
        }

    .submit-button {
        display: flex;
        justify-content: center;
    }

        .submit-button button {
            background-color: #012056;
            color: #fff;
            border: none;
            padding: 10px 20px;
            border-radius: 4px;
            cursor: pointer;
        }

            .submit-button button:hover {
                background-color: #0056b3;
            }


    .select2-selection {
        outline: 0;
        position: relative;
        height: auto !important;
    }

    .select2-search {
        position: absolute;
        left: 0;
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice__display {
        padding-left: 20px;
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
        padding: 0px 5px;
    }

    .select2-search__field {
        height: auto !important;
        padding: 0px 10px !important;
    }

    .pattern {
        display: flex;
    }

    .form-group input, .form-group select {
        padding: 5px;
    }

    .form-group label {
        font-weight: normal !important;
    }

    .select2-container .select2-selection--multiple {
        max-height: 80px;
        overflow: auto;
    }
</style>

