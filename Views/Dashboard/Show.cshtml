            delay: 250,
            data: function (params) {
                return {
                    KeyValue: params.term, // search term
                    ActionID: 4
                };
            },
            processResults: function (data) {
                var finalList = [{
                    id: 0,
                    text: ""
                }];
                // Process and map the results
                finalList = $.map(data, function (item) {
                    return {
                        id: item.Key,
                        text: item.Value
                    };
                });
                return {
                    results: finalList
                };
            },
            cache: true
        }
    });

