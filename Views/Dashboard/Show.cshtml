@using (Ajax.BeginForm("Export", "ControllerName", new AjaxOptions
{
    HttpMethod = "POST",
    OnSuccess = "Display",
    OnBegin = "OnBeginReport"
}, new { @class = "form-horizontal", role = "form" }))
{
<div class="container">
    <div class="header">
        <h1 style="font-weight:500">Data Extract</h1>
    </div>
    <div class="form-group">
        <label>From Date</label>
        <div>
            <input type="text" id="fromDate" class="form-control text-mandatory datepicker" autocomplete="off" value="@Model.DashboardDetails.FromDate">
            <span class="text-danger" id="fromDateError"></span>
        </div>
    </div>
    <div class="form-group">
        <label>To Date</label>
        <div>
            <input type="text" id="toDate" class="form-control text-mandatory datepicker" autocomplete="off" value="@Model.DashboardDetails.ToDate">
            <span class="text-danger" id="toDateError"></span>
        </div>
    </div>
    <div class="form-group">
        @Html.Label("Employee Name")
        <select id="DashboardDetails_Employee" name="DashboardDetails.SelectedEmployees" class="form-control" multiple="multiple" style="width: 100%;">
        </select>
        @Html.ValidationMessageFor(m => m.DashboardDetails.Employee, "", new { @class = "text-danger" })
    </div>
    <div class="form-group">
        @Html.Label("User ID")
        <select id="DashboardDetails_SelectedUserID" name="DashboardDetails.SelectedUserID" class="form-control" multiple="multiple" style="width: 100%;">
        </select>
        @Html.ValidationMessageFor(m => m.DashboardDetails.SelectedUserID, "", new { @class = "text-danger" })
    </div>
    <div class="form-group">
        <label for="mealType">Meal Type</label>
        <div>
            @Html.DropDownList("mealType", (IEnumerable<SelectListItem>)ViewBag.MealTypeList, "-- Select --", new { id = "mealType", @class = "form-control m-b-sm", @style = "width: 100%; color: #999; margin: 0px;" })
        </div>
    </div>
    <div class="form-group" id="mealSubtypeDropdown" style="display: none;">
        <label for="mealSubtype">Sub Meal Type</label>
        <div>
            @Html.DropDownList("mealSubtype", (IEnumerable<SelectListItem>)ViewBag.MealSubTypeList, "-- Select --", new { id = "mealSubtype", @class = "form-control m-b-sm", @style = "width: 100%; color: #999; margin: 0px;" })
        </div>
    </div>
    <div class="submit-button">
        <button type="submit" id="btnsubmit">Submit</button>
    </div>
</div>
}




